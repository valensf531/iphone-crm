# iPhone CRM — variables de entorno.
# Copiar a .env.local para desarrollo local y completar.
# En Vercel: cargar las mismas en Project → Settings → Environment Variables.

# Neon Postgres (pooled, con sslmode=require). Ej:
# postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# URL pública de la app (en Vercel: https://tu-proyecto.vercel.app)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Secreto de auth (generar con: openssl rand -hex 32). Único por ambiente.
BETTER_AUTH_SECRET=

# Orígenes extra separados por coma (previews de Vercel, dominio propio).
ADDITIONAL_TRUSTED_ORIGINS=
